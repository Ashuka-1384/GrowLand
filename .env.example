JWT_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
BLOB_DATA_SECRET=replace-with-a-different-long-random-secret
ADMIN_PHONE=+989xxxxxxxxx
# Plaintext is accepted only for local/dev convenience; use a scrypt hash in production.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CLIENT_URL=https://your-domain.vercel.app
# Set true only during a controlled migration of old JSON users that have no password.
ALLOW_LEGACY_LOGIN=false
