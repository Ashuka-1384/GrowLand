# Production / Vercel
NODE_ENV=production

# Authentication
JWT_SECRET=generate-a-new-random-secret-at-least-32-characters
ADMIN_PHONE=09333167279
ADMIN_NAME=GrowLand Admin\n# Production MUST use a scrypt hash generated by scripts/hash-password.mjs
ADMIN_PASSWORD=replace-with-scrypt-hash

# Vercel Blob (Private)
BLOB_READ_WRITE_TOKEN=your-private-vercel-blob-token
# Never reuse JWT_SECRET here. Use a different random value, at least 32 chars.
BLOB_DATA_SECRET=generate-a-different-random-secret-at-least-32-characters
# Versioned namespace. Use a NEW value for a genuinely fresh deployment.
BLOB_DB_PATH=growland/production-v1/db.json.enc

# Optional when the frontend and API are served from the same Vercel domain.
# For a custom frontend/API origin, set the exact allowed origin(s), comma-separated.
CLIENT_URL=https://your-domain.vercel.app

