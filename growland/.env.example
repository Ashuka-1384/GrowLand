# Required in production: use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret
# Master admin phone; defaults to the original seeded admin if omitted.
MASTER_ADMIN_PHONE=+989333167279
# Optional with a Vercel Blob store using OIDC (recommended in new connections).
# For older/static-token Blob stores, paste the store token here.
BLOB_READ_WRITE_TOKEN=
# Blob pathname for the durable JSON store.
GROWLAND_BLOB_PATH=growland/store.json
# Local development only. Vercel uses Blob storage automatically.
GROWLAND_DATA_FILE=./data/store.json
